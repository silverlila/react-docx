{
  "name": "@react-docx/core",
  "version": "0.1.8",
  "description": "A React custom renderer for generating Microsoft Word documents (.docx) using JSX",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "run-example": "npx tsx examples/basic.tsx",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:react": "pnpm run build && node test/react-lines/run.mjs",
    "examples": "for f in basic header-footer resume advanced; do tsx examples/$f.tsx || exit 1; done",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "react",
    "docx",
    "word",
    "document",
    "generation",
    "jsx",
    "reconciler",
    "microsoft-word",
    "office",
    "template"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/silverlila/react-docx"
  },
  "bugs": {
    "url": "https://github.com/silverlila/react-docx/issues"
  },
  "homepage": "https://github.com/silverlila/react-docx#readme",
  "author": "Silvi Lila",
  "license": "MIT",
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "docx": "^9.5.0"
  },
  "dependencies": {
    "domhandler": "^5.0.3",
    "fflate": "^0.8.3",
    "htmlparser2": "^10.1.0",
    "react-reconciler-29": "npm:react-reconciler@0.29.0",
    "react-reconciler-31": "npm:react-reconciler@0.31.0",
    "react-reconciler-33": "npm:react-reconciler@0.33.0",
    "xml-js": "^1.6.8"
  },
  "devDependencies": {
    "@types/node": "^24.3.1",
    "@types/react": "^18.2.0",
    "docx": "^9.5.1",
    "react": "^18.2.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "3.2.4",
    "react-19-0": "npm:react@19.0.0",
    "react-19-1": "npm:react@19.1.0",
    "react-19-2": "npm:react@19.2.0",
    "react-19-3": "npm:react@19.3.1"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
